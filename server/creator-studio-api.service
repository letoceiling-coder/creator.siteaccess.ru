[Unit]
Description=AI Creative Studio API (задачи генерации)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/creator-studio/api
ExecStart=/usr/bin/node --disable-warning=ExperimentalWarning server.mjs
Restart=on-failure
RestartSec=5
Environment=NODE_ENV=production
Environment=DOCKER_CONFIG=/var/lib/creator-studio/docker
# Telegram API с хостинга закрыт напрямую — запросы идут через HTTP-прокси.
Environment=TELEGRAM_PROXY=http://31.207.5.233:8888
Nice=5

# Пишет только в свои каталоги и во вход/выход ComfyUI.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/creator-studio /var/www/creator-media /srv/comfyui/data/ComfyUI/input /srv/comfyui/data/ComfyUI/output /run/docker.sock

[Install]
WantedBy=multi-user.target
